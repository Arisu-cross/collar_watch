# --- storage ---
HEALTH_DATA_DIR=./data/health
HEALTH_TZ_OFFSET_HOURS=0
# Optional: override which metric types are kept (comma-separated).
# HEALTH_ALLOWED_TYPES=heart_rate,heart_rate_variability,sleep_analysis,respiratory_rate

# --- ingest auth convention ---
# This repository does not include the HTTP ingest layer and does not read this
# variable itself. Use it in your own endpoint to validate X-Health-Token before
# calling health_store.normalize_payload()/store_samples().
HEALTH_INGEST_TOKEN=
