# --- storage ---
HEALTH_DATA_DIR=./data/health
HEALTH_TZ_OFFSET_HOURS=0
# Optional: override which metric types are kept (comma-separated).
# HEALTH_ALLOWED_TYPES=heart_rate,heart_rate_variability,sleep_analysis,respiratory_rate

# --- auth (server/app.py) ---
# 两把 token，各管一头，**不要设成同一个值**：
#   HEALTH_INGEST_TOKEN  设备侧（手表 / Health Auto Export）。凭它写数据、领指令。
#   COLLAR_MCP_TOKEN     agent 侧。凭它读 /mcp。
# 都不设 = 对应的口一律 401。⚠️ 缺头和错头返回的都是同一句 `bad token`，
# 分不出来是「忘了带」还是「带错了」—— 排查时别被它误导，先确认变量设没设。
HEALTH_INGEST_TOKEN=
COLLAR_MCP_TOKEN=
# 本地裸跑用：=1 时跳过上面两道校验。别在公网开。
# COLLAR_ALLOW_NO_AUTH=

# --- serving (server/app.py) ---
# PORT=8080
# MCP SDK 的 DNS rebinding 防护白名单，逗号分隔（":*" 通配端口）。
# 留空 = 关掉该防护（默认，因为 /mcp 本来就在 token 后面）。
# 注意：该防护默认是「开着但白名单为空」，那会让每个 Host 都吃 421。
# COLLAR_ALLOWED_HOSTS=your-host.example.com,your-host.example.com:*
# 入库前的类型改名，格式 from:to，逗号分隔。内置一份默认表，这个是追加。
# HEALTH_TYPE_ALIASES=oxygen_saturation:blood_oxygen_saturation

# --- MCP tools ---
# 逗号分隔的工具名，被点名的工具不注册（health_now / health_detail /
# measure_heart_rate）。用于「采集端已经撤掉、工具却还挂在 agent 手上」——
# 那种工具不会自己消失，agent 会一直伸手、一直拿到软失败，
# 而软失败读起来像「我看不见你的数据」。
# HEALTH_DISABLED_TOOLS=measure_heart_rate

# --- on-demand measurement (health_store.py) ---
# HEALTH_MEASURE_DURATION_S=30
# HEALTH_COMMAND_TTL_MIN=30

# --- stale alert (server/stale_alert.py) ---
# HEALTH_STALE_MINUTES=90
# HEALTH_STALE_TYPES=heart_rate
# HEALTH_ALERT_WEBHOOK=
# HEALTH_ALERT_COOLDOWN_MIN=180
# HEALTH_STALE_INTERVAL_MIN=15
