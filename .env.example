# --- storage ---
HEALTH_DATA_DIR=./data/health
HEALTH_TZ_OFFSET_HOURS=0
# Optional: override which metric types are kept (comma-separated).
# HEALTH_ALLOWED_TYPES=heart_rate,heart_rate_variability,sleep_analysis,respiratory_rate

# Optional: rename incoming metric types before the allow-list sees them.
# Exporters disagree on naming — Health Auto Export sends `active_energy` where
# the watch app sends `active_energy_burned`. A few such aliases are built in;
# add your own here as from=to pairs. GET /debug lists whatever got dropped, so
# you can see exactly which names your exporter actually sends.
# HEALTH_TYPE_ALIASES=active_energy=active_energy_burned,pulse=heart_rate

# --- auth (server/app.py) ---
# Devices — the watch app and/or Health Auto Export. Sent as X-Health-Token;
# Authorization: Bearer and ?token= are accepted too, for exporters that cannot
# set an arbitrary header. Unset means every ingest route answers 401.
HEALTH_INGEST_TOKEN=

# The agent side, guarding /mcp. Authorization: Bearer, or X-Token.
# Keep it different from HEALTH_INGEST_TOKEN: a device that can write samples
# has no business reading the whole history back.
COLLAR_MCP_TOKEN=

# Local development only — skips both checks above. Never set this on a host
# that is reachable from the internet.
# COLLAR_ALLOW_NO_AUTH=1

# --- serving ---
# Most platforms inject their own PORT; app.py binds whatever it finds here.
PORT=8080

# Optional DNS-rebinding protection for /mcp. Unset = off, which is the sane
# default for a token-protected public endpoint. If you do set it, list every
# hostname you serve under — the MCP SDK answers 421 to any Host not named
# here, so forgetting your own domain makes the endpoint reject everything.
# COLLAR_ALLOWED_HOSTS=collar.example.com,collar.example.com:*

# --- on-demand measurement (watch app only) ---
# HEALTH_MEASURE_DURATION_S=30
# HEALTH_COMMAND_TTL_MIN=30
